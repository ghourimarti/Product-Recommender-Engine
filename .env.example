# ---- LLM providers (Decision 4) ----
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...
ANTHROPIC_API_KEY=sk-ant-...

# ---- Embeddings (Decision 5) ----
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---- Vector DB: Qdrant (Decision 2) ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ---- Primary DB: DynamoDB (Decision 1) ----
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE=p2-recommender

# ---- Cache / queue: Redis (Decisions 10, 11) ----
REDIS_URL=redis://localhost:6379/0

# ---- Auth: Clerk (Decision 9) ----
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

# ---- Observability: Langfuse + OTel (Decision 13) ----
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ---- Experiments / kill-switch: GrowthBook (Decisions 19, 20) ----
GROWTHBOOK_API_HOST=
GROWTHBOOK_CLIENT_KEY=

# ---- App ----
APP_ENV=local
LOG_LEVEL=INFO
