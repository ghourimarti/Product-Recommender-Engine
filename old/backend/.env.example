# Copy to .env and fill in. NEVER commit the real .env (gitignored).

ENVIRONMENT=local
LOG_LEVEL=INFO

# Vector store (AstraDB — replaced by Qdrant in Step 4)
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_KEYSPACE=
VECTOR_COLLECTION_NAME=flipkart_database

# Embeddings
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
HUGGINGFACEHUB_API_TOKEN=

# LLM
GROQ_API_KEY=
RAG_MODEL=llama-3.1-8b-instant
RAG_TEMPERATURE=0.5
RETRIEVAL_K=3
