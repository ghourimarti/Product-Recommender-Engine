# Copy this file to .env and fill in real values before running the project.
# Never commit .env to version control.

# --------------------------------------------------------------------------
# Required
# --------------------------------------------------------------------------

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-minimum-32-characters-long

# Groq API key — obtain from https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# --------------------------------------------------------------------------
# Optional (defaults shown)
# --------------------------------------------------------------------------

MODEL_NAME=llama-3.1-8b-instant
CHROMA_PERSIST_DIR=chroma_db
ACCESS_TOKEN_EXPIRE_MINUTES=30
RATE_LIMIT_PER_MINUTE=10
DEBUG=false

# Groq token pricing (per million tokens, update if pricing changes)
COST_INPUT_PER_M_TOKENS=0.05
COST_OUTPUT_PER_M_TOKENS=0.08
