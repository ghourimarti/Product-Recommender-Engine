<!-- ClickHouse's built-in Prometheus endpoint (port 9363, in-network only): Langfuse's trace
     store reports queries, inserts, memory and merges without a separate exporter. -->
<clickhouse>
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
    </prometheus>
</clickhouse>
