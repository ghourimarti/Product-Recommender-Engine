{
  "uid": "p2-health",
  "title": "P2 - Service health",
  "description": "Is every component up, is anything alerting, and the headline numbers. Grafana's home page.",
  "tags": [
    "p2"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "P2 dashboards",
      "type": "dashboards",
      "tags": [
        "p2"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Langfuse (signed in)",
      "type": "link",
      "url": "http://localhost:2008",
      "targetBlank": true
    },
    {
      "title": "Jaeger",
      "type": "link",
      "url": "http://localhost:2006",
      "targetBlank": true
    },
    {
      "title": "Prometheus",
      "type": "link",
      "url": "http://localhost:2009/targets",
      "targetBlank": true
    },
    {
      "title": "RedisInsight",
      "type": "link",
      "url": "http://localhost:2005",
      "targetBlank": true
    },
    {
      "title": "Web app",
      "type": "link",
      "url": "http://localhost:2012",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Is every service answering? (blackbox probes, every 15s)",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Services",
      "id": 2,
      "description": "HTTP health endpoints and TCP connects, probed from inside the network.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(probe_success, \"service\", \"$1\", \"instance\", \"(?:https?://)?([^:/]+).*\")",
          "legendFormat": "{{service}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      }
    },
