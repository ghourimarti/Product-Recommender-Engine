        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(redis_keyspace_hits_total[15m]) / clamp_min(rate(redis_keyspace_hits_total[15m]) + rate(redis_keyspace_misses_total[15m]), 1e-9)",
