{
  "title": "P2 Recommender — Overview",
  "uid": "p2-overview",
  "tags": ["p2"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "SerpApi searches spent (24h)  — quota 250/month",
      "description": "The binding constraint on the whole product. Every aggregate cache MISS spends one metered search.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "red", "value": 40 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "increase(serpapi_searches_total[24h])", "legendFormat": "searches/24h" }
      ]
    },
    {
      "type": "stat",
      "title": "Cache hit rate (target ≥ 60%)",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        {
          "expr": "sum(rate(cache_hits_total[15m])) / clamp_min(sum(rate(cache_hits_total[15m])) + sum(rate(cache_misses_total[15m])), 0.001)",
          "legendFormat": "hit rate"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Degraded responses (source unavailable)",
      "description": "A dead shopping source. NOT the same as no_match.",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum by (reason) (increase(source_unavailable_total[1h]))", "legendFormat": "{{reason}}" }
      ]
    },
    {
      "type": "stat",
      "title": "Guardrail blocks (injection)",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "sum by (kind) (increase(guardrail_blocks_total[1h]))", "legendFormat": "{{kind}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 latency by endpoint",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request rate by status",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        { "expr": "sum by (status) (rate(http_requests_total[1m]))", "legendFormat": "{{status}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cache hits vs misses by layer",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [
        { "expr": "sum by (layer) (rate(cache_hits_total[5m]))", "legendFormat": "hit {{layer}}" },
        { "expr": "sum by (layer) (rate(cache_misses_total[5m]))", "legendFormat": "miss {{layer}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "no_match rate (spike ⇒ retrieval may be broken)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [
        { "expr": "rate(no_match_total[5m])", "legendFormat": "no_match/s" }
      ]
    }
  ]
}
