  "description": "Request traffic, latency and errors per endpoint; every LLM call per provider (latency, tokens, failover); cache effectiveness; the API process.",
  "tags": [
    "p2"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "P2 dashboards",
      "type": "dashboards",
      "tags": [
        "p2"
      ],
