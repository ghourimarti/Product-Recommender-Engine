# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Env / secrets
.env
.env.*
!.env.example

# Node / Next.js
node_modules/
.next/
dist/
*.tsbuildinfo
# npm bin shims land here when a package is installed at the repo root by mistake.
/playwright
/playwright.cmd
/playwright.ps1

# Terraform
.terraform/
*.tfstate
*.tfstate.*
# Plan files embed state (and can embed secrets). `*.tfplan` alone missed the
# extensionless default name `terraform plan -out=tfplan` produces.
tfplan
*.tfplan

# Vendored installer scripts (fetch them, don't commit them)
get_helm.sh

# OS / IDE
.DS_Store
Thumbs.db
READMEcopy.md

# Private working notes (planning drafts) — not part of the shipped project
Prompts/
demo/
old/
# NOTE: screenshots/ is deliberately NOT ignored. It is embedded in the README,
# so it is published material. Ignoring it once meant a stale screenshot (showing
# social proof the app no longer renders) silently survived a UI rewrite.

# Local editor / assistant tooling
.claude/

# Working docs (planning notes, eval reports, runbooks) are kept local only.
# The CI eval gate reads packages/evaluation/ranking/baseline.json (tracked), not docs/.
docs/